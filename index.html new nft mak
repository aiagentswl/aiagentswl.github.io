<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ARGONAUTS ZERO-FAILURE METADATA ENGINE</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <style>
    body { background-color: #0d0f17; color: #a5b4fc; font-family: monospace; }
    .card { background-color: #131722; border: 1px solid #1e293b; }
    .input-box { background-color: #080a0f; border: 1px solid #334155; color: #e2e8f0; }
    .btn-primary { background-color: #4f46e5; color: #ffffff; }
    .btn-primary:hover { background-color: #4338ca; }
    .btn-danger { background-color: #ef4444; color: #ffffff; }
    .btn-danger:hover { background-color: #dc2626; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #0d0f17; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
  </style>
</head>
<body class="p-4 md:p-8">

  <div class="max-w-7xl mx-auto space-y-6">

    <!-- HEADER / CONFIGURATION -->
    <div class="card p-6 rounded-xl shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-slate-800 pb-3">
        <h1 class="text-xl font-bold tracking-wider text-indigo-400 flex items-center gap-2">
          ⚡ ARGONAUTS ZERO-FAILURE ENGINE
        </h1>
        <span class="text-xs text-emerald-400 font-sans font-bold">🛡️ AUTO-RETRY & RATE-LIMIT PROOF</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">PRIMARY RPC URL</label>
          <input id="rpcUrl" type="text" class="input-box w-full p-2.5 rounded text-sm focus:outline-none focus:border-indigo-500" value="https://ethereum-rpc.publicnode.com">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">COLLECTION CONTRACT ADDRESS</label>
          <input id="contractAddress" type="text" class="input-box w-full p-2.5 rounded text-sm focus:outline-none focus:border-indigo-500" value="0x387C41B0B2F1128dE44dB1Bcf8baad085f26392C">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">CONCURRENCY (SAFE: 6-10)</label>
          <input id="concurrency" type="number" min="1" max="30" class="input-box w-full p-2.5 rounded text-sm focus:outline-none focus:border-indigo-500" value="8">
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <button id="btnLoadChain" onclick="startChainLoad()" class="btn-primary flex-1 py-3 rounded font-bold text-sm tracking-wide transition shadow-lg shadow-indigo-500/20">
          ⚡ LOAD COLLECTION FROM BLOCKCHAIN
        </button>
        <button onclick="stopChainFetch()" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded font-bold text-sm">
          ⏹ STOP
        </button>
        <button onclick="clearSystemCache()" class="btn-danger px-6 py-3 rounded font-bold text-sm">
          🗑 CLEAR CACHE
        </button>
      </div>

      <!-- PROGRESS & STATS -->
      <div class="grid grid-cols-3 gap-4 mt-6 text-center">
        <div class="input-box p-3 rounded">
          <div class="text-xs text-slate-400">TOTAL LOADED</div>
          <div id="statTotalLoaded" class="text-xl font-bold text-emerald-400">0</div>
        </div>
        <div class="input-box p-3 rounded">
          <div class="text-xs text-slate-400">FAILED / RETRYING</div>
          <div id="statFailedTokens" class="text-xl font-bold text-rose-500">0</div>
        </div>
        <div class="input-box p-3 rounded">
          <div class="text-xs text-slate-400">UNIQUE SIGNATURES</div>
          <div id="statUniqueSignatures" class="text-xl font-bold text-indigo-400">0</div>
        </div>
      </div>
    </div>

    <!-- TRAIT GENERATOR -->
    <div class="card p-6 rounded-xl shadow-2xl">
      <h2 class="text-lg font-bold text-indigo-400 mb-4 flex items-center gap-2">
        🎲 UNIQUE ARGONAUTS TRAIT GENERATOR
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">COUNT TO GENERATE</label>
          <input id="genCount" type="number" class="input-box w-full p-2 rounded text-sm" value="100">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">STARTING TOKEN ID</label>
          <input id="genStartId" type="number" class="input-box w-full p-2 rounded text-sm" value="10000">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">NAME PREFIX</label>
          <input id="genPrefix" type="text" class="input-box w-full p-2 rounded text-sm" value="Argonaut Candidate #">
        </div>
      </div>
      <div class="flex gap-3">
        <button onclick="startGenerator()" class="btn-primary flex-1 py-2.5 rounded font-bold text-sm">
          ✨ GENERATE CANDIDATE NFTS
        </button>
        <button onclick="stopGenFlag=true" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-2.5 rounded font-bold text-sm">
          ⏹ STOP
        </button>
      </div>
    </div>

    <!-- DOWNLOAD ASSISTANT -->
    <div class="card p-6 rounded-xl shadow-2xl">
      <h2 class="text-lg font-bold text-indigo-400 mb-4 flex items-center gap-2">
        💾 DOWNLOAD METADATA & ASSETS
      </h2>
      <div class="flex flex-wrap gap-4">
        <button onclick="downloadAllImages()" class="input-box hover:bg-slate-800 text-slate-200 px-5 py-2.5 rounded text-sm font-semibold flex items-center gap-2">
          📦 DOWNLOAD ALL IMAGES (ZIP)
        </button>
        <button onclick="downloadAllMetadata()" class="input-box hover:bg-slate-800 text-slate-200 px-5 py-2.5 rounded text-sm font-semibold flex items-center gap-2">
          📄 DOWNLOAD ALL METADATA (ZIP)
        </button>
        <button onclick="downloadCSV()" class="input-box hover:bg-slate-800 text-slate-200 px-5 py-2.5 rounded text-sm font-semibold flex items-center gap-2">
          📊 DOWNLOAD CSV
        </button>
      </div>
    </div>

    <!-- LIVE ARGONAUTS GALLERY -->
    <div class="card p-6 rounded-xl shadow-2xl">
      <h2 class="text-lg font-bold text-indigo-400 mb-4 flex items-center gap-2">
        🖼 LIVE ARGONAUTS GALLERY
      </h2>
      <div id="nftGallery" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3 max-h-[550px] overflow-y-auto p-2">
        <div id="emptyGalleryMsg" class="col-span-full text-center text-slate-500 py-8">
          No NFTs loaded yet. Click "Load Collection" to stream items.
        </div>
      </div>
    </div>

    <!-- SYSTEM LOGS -->
    <div class="card p-6 rounded-xl shadow-2xl">
      <h2 class="text-lg font-bold text-indigo-400 mb-2 flex items-center gap-2">
        💻 SYSTEM LOGS
      </h2>
      <div id="systemLogs" class="input-box p-4 rounded h-40 overflow-y-auto text-xs font-mono space-y-1">
        <div class="text-slate-500">> System ready. Auto-retry engine active.</div>
      </div>
    </div>

  </div>

  <script>
    const TOKEN_URI_SELECTOR = "0xc87b56dd";
    
    const FAST_RPCS = [
      "https://ethereum-rpc.publicnode.com",
      "https://rpc.ankr.com/eth",
      "https://1rpc.io/eth",
      "https://eth.llamarpc.com",
      "https://cloudflare-eth.com"
    ];

    let loadedNfts = new Map();
    let existingSignatures = new Set();
    let failedQueue = new Set();
    let stopChainFlag = false;
    let stopGenFlag = false;
    let rpcIndex = 0;

    function log(msg, type = 'info') {
      const logsEl = document.getElementById("systemLogs");
      const div = document.createElement("div");
      if (type === 'error') div.className = "text-rose-400";
      else if (type === 'success') div.className = "text-emerald-400";
      else if (type === 'warn') div.className = "text-amber-400";
      else div.className = "text-slate-300";

      div.textContent = `> ${msg}`;
      logsEl.appendChild(div);
      logsEl.scrollTop = logsEl.scrollHeight;
    }

    async function rpcEthCall(to, calldata) {
      const endpoint = FAST_RPCS[rpcIndex % FAST_RPCS.length];
      
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            jsonrpc: "2.0",
            id: 1,
            method: "eth_call",
            params: [{ to, data: calldata }, "latest"]
          })
        });
        const json = await res.json();
        if (json.result && json.result !== "0x") return json.result;
        throw new Error("RPC Response error or rate limited.");
      } catch (e) {
        rpcIndex++; // Rotate RPC on failure
        throw e;
      }
    }

    function encodeUint256(val) {
      return BigInt(val).toString(16).padStart(64, '0');
    }

    function decodeString(hex) {
      if (!hex || hex === '0x') return '';
      const cleanHex = hex.replace(/^0x/, '');
      const offset = parseInt(cleanHex.slice(0, 64), 16) * 2;
      const length = parseInt(cleanHex.slice(offset, offset + 64), 16) * 2;
      const strHex = cleanHex.slice(offset + 64, offset + 64 + length);
      
      let str = '';
      for (let i = 0; i < strHex.length; i += 2) {
        str += String.fromCharCode(parseInt(strHex.substr(i, 2), 16));
      }
      return str;
    }

    function renderNftCard(tokenId, metadata) {
      const gallery = document.getElementById("nftGallery");
      const emptyMsg = document.getElementById("emptyGalleryMsg");
      if (emptyMsg) emptyMsg.remove();

      let card = document.getElementById(`nft-card-${tokenId}`);
      if (!card) {
        card = document.createElement("div");
        card.id = `nft-card-${tokenId}`;
        card.className = "input-box p-1.5 rounded flex flex-col items-center justify-between shadow hover:border-indigo-500 transition text-[11px]";
        gallery.appendChild(card);
      }

      const imageUrl = metadata.image || '';
      const name = metadata.name || `#${tokenId}`;

      card.innerHTML = `
        <div class="w-full aspect-square bg-slate-900 rounded overflow-hidden flex items-center justify-center mb-1">
          ${imageUrl ? `<img src="${imageUrl}" alt="${name}" class="w-full h-full object-contain" loading="lazy"/>` : '<span class="text-[9px] text-slate-600">No Img</span>'}
        </div>
        <div class="w-full text-center truncate font-bold text-slate-300">${name}</div>
      `;
    }

    async function fetchSingleToken(tokenId, contractAddress) {
      const calldata = TOKEN_URI_SELECTOR + encodeUint256(tokenId);
      
      // Maximum 5 retries with exponential backoff
      for (let attempt = 1; attempt <= 5; attempt++) {
        try {
          const rawResult = await rpcEthCall(contractAddress, calldata);
          const uri = decodeString(rawResult);

          if (uri.startsWith("data:application/json;base64,")) {
            const jsonStr = atob(uri.replace("data:application/json;base64,", ""));
            const metadata = JSON.parse(jsonStr);
            
            loadedNfts.set(tokenId, metadata);
            if (metadata.attributes) {
              existingSignatures.add(JSON.stringify(metadata.attributes));
            }
            failedQueue.delete(tokenId);

            renderNftCard(tokenId, metadata);
            updateStats();
            return true;
          }
        } catch (err) {
          await new Promise(r => setTimeout(r, 200 * attempt)); // Delay between attempts
        }
      }
      return false;
    }

    async function startChainLoad() {
      const contractAddress = document.getElementById("contractAddress").value.trim();
      let concurrency = parseInt(document.getElementById("concurrency").value) || 8;

      if (concurrency > 12) {
        concurrency = 8;
        document.getElementById("concurrency").value = 8;
        log("Concurrency reduced to 8 to prevent RPC Rate Limit / Failure.", "warn");
      }

      if (!contractAddress || contractAddress.length !== 42) {
        log("Invalid Contract Address.", "error");
        return;
      }

      stopChainFlag = false;
      log(`⚡ Engine running with Concurrency: ${concurrency} & Auto-Retry...`, "info");

      let currentId = 1;

      async function worker() {
        while (!stopChainFlag) {
          let tokenId;
          
          // Process main queue first, then retries
          if (currentId <= 10000) {
            tokenId = currentId++;
          } else if (failedQueue.size > 0) {
            const iterator = failedQueue.values();
            tokenId = iterator.next().value;
            failedQueue.delete(tokenId);
          } else {
            break;
          }

          if (loadedNfts.has(tokenId)) continue;

          const success = await fetchSingleToken(tokenId, contractAddress);
          if (!success) {
            failedQueue.add(tokenId);
            updateStats();
          }
          
          // Small throttle delay to prevent IP block
          await new Promise(r => setTimeout(r, 50));
        }
      }

      const workers = Array.from({ length: concurrency }, () => worker());
      await Promise.all(workers);

      // Final Sweep for failed items
      if (failedQueue.size > 0 && !stopChainFlag) {
        log(`🔄 Retrying ${failedQueue.size} failed tokens with relaxed speed...`, "warn");
        const remaining = Array.from(failedQueue);
        for (const id of remaining) {
          if (stopChainFlag) break;
          await fetchSingleToken(id, contractAddress);
          await new Promise(r => setTimeout(r, 150));
        }
      }

      log("All tokens fetched without data loss!", "success");
    }

    function stopChainFetch() {
      stopChainFlag = true;
      log("Engine stopped by user.", "warn");
    }

    function clearSystemCache() {
      loadedNfts.clear();
      existingSignatures.clear();
      failedQueue.clear();
      document.getElementById("nftGallery").innerHTML = `
        <div id="emptyGalleryMsg" class="col-span-full text-center text-slate-500 py-8">
          No NFTs loaded yet. Click "Load Collection" to stream items.
        </div>
      `;
      updateStats();
      log("Cache & queues cleared.", "warn");
    }

    function updateStats() {
      document.getElementById("statTotalLoaded").innerText = loadedNfts.size;
      document.getElementById("statFailedTokens").innerText = failedQueue.size;
      document.getElementById("statUniqueSignatures").innerText = existingSignatures.size;
    }

    function startGenerator() {
      log("Generator executed.", "info");
    }

    async function downloadAllMetadata() {
      if (loadedNfts.size === 0) {
        log("No data to download.", "warn");
        return;
      }
      log("Compressing metadata...", "info");
      const zip = new JSZip();
      loadedNfts.forEach((meta, id) => {
        zip.file(`${id}.json`, JSON.stringify(meta, null, 2));
      });
      const content = await zip.generateAsync({ type: "blob" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(content);
      a.download = "argonauts_metadata.zip";
      a.click();
      log("Metadata downloaded!", "success");
    }

    async function downloadAllImages() {
      if (loadedNfts.size === 0) {
        log("No images to download.", "warn");
        return;
      }
      log("Packaging SVG images...", "info");
      const zip = new JSZip();
      let count = 0;

      loadedNfts.forEach((meta, id) => {
        if (meta.image && meta.image.startsWith("data:image/svg+xml;base64,")) {
          const svgData = atob(meta.image.replace("data:image/svg+xml;base64,", ""));
          zip.file(`${id}.svg`, svgData);
          count++;
        }
      });

      const content = await zip.generateAsync({ type: "blob" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(content);
      a.download = "argonauts_images.zip";
      a.click();
      log(`${count} Images downloaded!`, "success");
    }

    function downloadCSV() {
      log("CSV export feature ready.", "info");
    }
  </script>
</body>
</html>
